# Copy to .env (git-ignored) and fill in. Read on the FIRST run only for the widget values below;
# after that the database (edited in the app) is the source of truth.

# Server
HUB_PORT=8080
# HUB_HOST=0.0.0.0
# HUB_TZ=Europe/London
# Where the projects this dashboard launches live (defaults to the folder above this one)
# HUB_PROJECTS_DIR=/home/you/Projects
# Public address used in enrol links (default: this machine's LAN IP + port)
# HUB_PUBLIC_URL=http://dash.local:8080

# Media server shown on the guest page
JELLYFIN_URL=

# Bins: council property reference (Salford: find yours at https://www.findmyaddress.co.uk/search)
BINS_UPRN=

# Calendar: Google Calendar -> Settings -> "Secret address in iCal format". Treat like a password.
DIARY_ICAL_URL=
